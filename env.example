# Copy to .env.local and fill in. NEVER commit real values to this file.
# The values previously here were live and must be ROTATED —
# see VERCEL_MIGRATION_PLAN.md §6.2.

# Firebase Admin SDK. Prefer Vercel OIDC + Google Workload Identity Federation;
# this keeps a long-lived private key out of Vercel. FIREBASE_PRIVATE_KEY remains
# a backwards-compatible fallback for local/legacy deployments only. Firebase
# Admin remains identity-only until the mobile compatibility gate (§2.3) closes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=

# Temporary mobile compatibility bridge. These are public project identifiers,
# not an Appwrite API key. The route verifies the caller with a short-lived JWT.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=69906e3f0020c208d8e7

# Appwrite session/status revocation webhook. Configure the webhook for only
# `users.*.sessions.*.delete` and `users.*.update.status`. The URL must exactly
# match the HTTPS URL registered in Appwrite because it is part of Appwrite's
# HMAC-SHA1 signature input. The signing secret is not an Appwrite API key.
APPWRITE_WEBHOOK_ID=
APPWRITE_WEBHOOK_URL=
APPWRITE_WEBHOOK_SECRET=

# Phase 0 bootstrap admin login. The app fails closed unless both values meet the
# minimum lengths. Use a unique passphrase (16+ bytes) and a random signing secret
# (32+ bytes, e.g. `openssl rand -base64 32`). Rotate either value to invalidate
# access; rotating ADMIN_SESSION_SECRET immediately invalidates all sessions.
# This bootstrap is replaced by Auth.js Google/Apple + DB roles before real data.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Transactional account verification. VERIFICATION_ADMIN_EMAILS accepts a
# comma- or semicolon-separated list; every recipient gets a private copy of a
# manual review request. The first admin approval resolves the shared request.
# If omitted, the recipient list defaults to lucas@lingiq.ai.
# Production defaults to Resend. Preview/staging can select gmail_smtp and use
# a Google App Password; never commit the real password to an env file.
VERIFICATION_EMAIL_TRANSPORT=resend
RESEND_API_KEY=
VERIFICATION_FROM_EMAIL=Third & Manageable <verification@your-verified-domain.com>
VERIFICATION_ADMIN_EMAILS=lucas@lingiq.ai
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=

# Postgres — injected automatically by the Vercel/Neon Marketplace integration.
# The app uses the pooled endpoint; migrations prefer the direct endpoint (§2.2).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
