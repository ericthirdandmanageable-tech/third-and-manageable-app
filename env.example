# Copy to .env.local and fill in. NEVER commit real values to this file.
# The values previously here were live and must be ROTATED —
# see VERCEL_MIGRATION_PLAN.md §6.2.

# Firebase Admin SDK — Firebase Console → Project Settings → Service Accounts.
# Removed entirely at Phase 3 step 20, when Firestore is retired.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Temporary mobile compatibility bridge. These are public project identifiers,
# not an Appwrite API key. The route verifies the caller with a short-lived JWT.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=69906e3f0020c208d8e7

# Phase 0 bootstrap admin login. The app fails closed unless both values meet the
# minimum lengths. Use a unique passphrase (16+ bytes) and a random signing secret
# (32+ bytes, e.g. `openssl rand -base64 32`). Rotate either value to invalidate
# access; rotating ADMIN_SESSION_SECRET immediately invalidates all sessions.
# This bootstrap is replaced by Auth.js Google/Apple + DB roles before real data.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional local escape hatch for a cross-origin FastAPI bridge. Normally leave
# this unset: the browser calls same-origin `/bridge`, which Next proxies to
# `http://127.0.0.1:8001` in development and Vercel routes to the FastAPI
# Service in Phase 2 step 11. A value here is public and requires CORS on the
# bridge. Deleted when Route Handlers take over at Phase 2 step 16 (§2.0).
NEXT_PUBLIC_API_URL=

# Optional server-side override for the local `/bridge` proxy target.
BRIDGE_ORIGIN=

# Postgres — injected automatically by the Vercel/Neon Marketplace integration.
# The app uses the pooled endpoint; migrations prefer the direct endpoint (§2.2).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
