# Copy to .env.local for local development. Never commit real secret values.

# Integration safety boundary. The Next.js redesign is a staging client.
# Vercel Preview fails closed unless this value is `staging` and the two public
# project IDs below match the isolated staging projects exactly.
INTEGRATION_ENVIRONMENT=staging

# Appwrite — authentication and session lifecycle only.
# APPWRITE_API_KEY is server-only. Create it in the staging project with only
# sessions.write, users.read, users.write, files.read, and files.write (needed
# for SSR login, moderation, self-service deletion, and profile pictures).
# Store it only in Vercel Preview.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=69906dfc003364b9847e
APPWRITE_API_KEY=

# Firebase Admin — Firestore product data and temporary Firebase custom tokens.
# Prefer Vercel OIDC + Google Workload Identity Federation. The service-account
# identity needs Firebase Authentication Admin and roles/datastore.user on the
# staging project. Key variables are a local/emergency fallback only.
FIREBASE_PROJECT_ID=third-and-manageable-staging
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Public-read profile images are written server-side to this staging Appwrite
# Storage bucket. The API key additionally needs files.read and files.write.
APPWRITE_PROFILE_PICTURES_BUCKET_ID=profile-pictures

# Appwrite session/status revocation webhook for staging only.
APPWRITE_WEBHOOK_ID=
APPWRITE_WEBHOOK_URL=
APPWRITE_WEBHOOK_SECRET=

# Bootstrap admin login. Keep Preview and Production values independently
# rotated. This remains a pre-production control, not final admin identity.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Account verification email. Preview uses its isolated Gmail App Password.
# A future production release should use a verified Resend sending domain.
VERIFICATION_EMAIL_TRANSPORT=gmail_smtp
VERIFICATION_FROM_EMAIL=
VERIFICATION_ADMIN_EMAILS=lucas@lingiq.ai
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
RESEND_API_KEY=

# Vercel AI Gateway uses the deployment-provided OIDC token. Do not add a
# client-visible Gemini key; Clipboard requests stay server-side.
