# Copy to .env.local and fill in. NEVER commit real values to this file.
# The values previously here were live and must be ROTATED —
# see VERCEL_MIGRATION_PLAN.md §6.2.

# Firebase Admin SDK — Firebase Console → Project Settings → Service Accounts.
# Removed entirely at Phase 3 step 20, when Firestore is retired.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin portal login.
# WARNING: current auth is a shared password + an UNSIGNED constant cookie, and is
# forgeable by anyone — see VERCEL_MIGRATION_PLAN.md §6.1. Replaced by per-admin
# accounts with hashed passwords at Phase 3 step 21.
ADMIN_PASSWORD=

# Base URL for redirects.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Postgres — injected automatically by the Vercel/Neon Marketplace integration.
# Use the POOLED endpoint; serverless functions exhaust direct connections (§2.2).
DATABASE_URL=
