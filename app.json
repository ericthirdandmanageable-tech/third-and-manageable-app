{
  "expo": {
    "name": "Third & Manageable",
    "slug": "third-and-manageable-app",
    "version": "1.0.1",
    "owner": "eric.thirdandmanageable",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "thirdandmanageableapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "buildNumber": "11",
      "bundleIdentifier": "com.thirdandmanageable.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow Third & Manageable to use your camera so you can upload a profile photo.",
        "NSPhotoLibraryUsageDescription": "Allow Third & Manageable to access your photo library so you can choose a profile photo.",
        "NSPhotoLibraryAddUsageDescription": "Allow Third & Manageable to save profile photo edits when needed.",
        "NSUserNotificationsUsageDescription": "Allow notifications for daily check-in reminders and support updates."
      }
    },
    "android": {
      "package": "com.thirdandmanageable.app",
      "adaptiveIcon": {
        "backgroundColor": "#040485",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "launcher"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#040485",
          "dark": {
            "backgroundColor": "#030366"
          }
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#040485"
        }
      ],
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-image",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7d162617-1e50-4351-8de0-519f8063bc4d"
      }
    }
  }
}
