/# Backend env — copy to .env and fill in.
# DATABASE_URL uses SQLite for local dev; Render injects a Postgres URL.
DATABASE_URL=sqlite:///./third_manageable.db
JWT_SECRET=change-me-in-production
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Leave blank to use the safe seeded Gemini fallback (no external calls).
GEMINI_API_KEY=

# Comma-separated origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173