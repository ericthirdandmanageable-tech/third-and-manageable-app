# Backend env — copy to .env and fill in. Never commit real values here.
# The FastAPI bridge is temporary (VERCEL_MIGRATION_PLAN.md §2.2); this whole
# file goes away with `backend/` at Phase 2 step 16.

# SQLite for local dev. On Vercel this is Neon's POOLED URL — serverless
# functions exhaust direct connections; the direct URL is for migrations only.
DATABASE_URL=sqlite:///./third_manageable.db

# HS256 signing key. Anyone holding it can mint a token for any user id, so
# production refuses to start if this is missing, still the default below, or
# shorter than 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-in-production
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Leave blank to use the safe seeded Gemini fallback (no external calls).
GEMINI_API_KEY=

# `production` arms the startup safety checks. Left unset, it is inferred from
# Vercel's VERCEL_ENV, where preview counts as production because a preview
# deployment is internet-reachable. Set it explicitly when hosting elsewhere.
ENVIRONMENT=development

# Auto-verify new registrations so the full flow is walkable locally. Production
# refuses to start with this on: verified=True is granted by a review step
# (roster DB / .edu allow-list) and it gates writes to Community.
AUTO_VERIFY=true

# Comma-separated CORS origins. Empty on purpose — the browser reaches the
# bridge through a same-origin `/bridge` rewrite (`next.config.ts` locally,
# `vercel.json` in production), so no cross-origin request is ever made. Only
# needed for the NEXT_PUBLIC_API_URL escape hatch. Never `*`: the bridge sends
# credentialed responses.
CORS_ORIGINS=
