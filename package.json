{
  "name": "third-and-manageable-unified-liquid-glass",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "start:clear": "expo start --dev-client --clear",
    "start:go": "expo start --go",
    "reset-project": "node ./scripts/reset-project.js",
    "smoke:staging-auth": "node ./scripts/staging-auth-smoke.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "check:staging-env": "node ./scripts/assert-staging-env.mjs",
    "check:eas-development-env": "npx eas-cli env:exec development \"node ./scripts/assert-staging-env.mjs\" --non-interactive",
    "check:eas-preview-env": "npx eas-cli env:exec preview \"node ./scripts/assert-staging-env.mjs\" --non-interactive",
    "build:dev": "npm run check:eas-development-env && npx eas-cli build --profile development --platform all",
    "build:dev:android": "npm run check:eas-development-env && npx eas-cli build --profile development --platform android",
    "build:dev:ios": "npm run check:eas-development-env && npx eas-cli build --profile development --platform ios",
    "build:dev:ios:simulator": "npm run check:eas-development-env && npx eas-cli build --profile development-simulator --platform ios",
    "register:device:ios": "npx eas-cli device:create",
    "build:staging": "npm run check:eas-preview-env && npx eas-cli build --profile staging --platform all",
    "build:preview": "npm run check:eas-preview-env && npx eas-cli build --profile preview --platform all",
    "build:preview:android": "npm run check:eas-preview-env && npx eas-cli build --profile preview --platform android",
    "build:preview:ios": "npm run check:eas-preview-env && npx eas-cli build --profile preview --platform ios",
    "build:preview:ios:simulator": "npm run check:eas-preview-env && npx eas-cli build --profile preview-simulator --platform ios",
    "build:production": "npx eas-cli build --profile production --platform all",
    "build:production:android": "npx eas-cli build --profile production --platform android",
    "build:production:ios": "npx eas-cli build --profile production --platform ios",
    "submit:production:ios": "npx eas-cli submit --profile production --platform ios",
    "update": "npx eas-cli update",
    "doctor": "npx expo-doctor",
    "test": "node --experimental-strip-types --experimental-loader ./tests/ts-loader.mjs --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/dm-mono": "^0.4.2",
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@expo-google-fonts/raleway": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "~57.0.6",
    "expo": "~57.0.14",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.12",
    "expo-constants": "~57.0.12",
    "expo-dev-client": "~57.0.13",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.11",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-notifications": "~57.0.12",
    "expo-router": "~57.0.14",
    "expo-sharing": "~57.0.13",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "firebase": "^12.17.1",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-appwrite": "^0.34.0",
    "react-native-css-interop": "^0.2.6",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/node": "^24.10.13",
    "@types/react": "~19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "expo-file-system": "$expo-file-system"
  },
  "private": true
}
