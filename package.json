{
  "name": "admin-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:auth": "vitest run tests/admin-session.test.ts",
    "check:vercel-manifest": "node scripts/check-vercel-manifest.mjs",
    "check:audit": "npm audit --omit=dev --audit-level=low",
    "firebase:inventory": "node scripts/firebase-readonly-inventory.mjs",
    "test:firestore-rules": "node scripts/run-firestore-rules-tests.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:test:neon": "vercel env run -e development --scope ling-iq -- node scripts/test-neon-baseline.mjs",
    "db:test:canonical-identity": "vercel env run -e development --scope ling-iq -- node scripts/test-neon-canonical-identity.mjs",
    "db:test:athlete-api": "vercel env run -e development --scope ling-iq -- node scripts/test-neon-athlete-api.mjs",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@vercel/firewall": "^1.2.3",
    "@vercel/oidc": "^3.8.2",
    "ai": "^6.0.249",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "firebase-admin": "13.6.1",
    "google-auth-library": "^10.9.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.574.0",
    "next": "^16.2.12",
    "node-appwrite": "^27.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "ws": "^8.21.1"
  },
  "comment:overrides": "Advisory remediation for transitive deps whose parents ship no patched release. Upstream-first: re-check on every `next`/`firebase-admin`/`vercel` bump and drop entries the parent has caught up to. The firebase-admin block disappears wholesale at the §2.3 retirement gate. Dev-tool entries are scoped to their root package — a global `ajv` bump breaks ESLint's own (unaffected) ajv 6.",
  "overrides": {
    "postcss": "^8.5.23",
    "nanoid": "^3.3.17",
    "sharp": "^0.35.3",
    "uuid": "^11.1.1",
    "brace-expansion": "^5.0.9",
    "minimatch": "^10.2.5",
    "glob": "^13.0.6",
    "rimraf": "^6.1.3",
    "gaxios": "^7.3.0",
    "@tootallnate/once": "^3.0.1",
    "tar": "^7.5.22",
    "path-to-regexp": "^8.4.2",
    "smol-toml": "^1.7.0",
    "js-yaml": "^5.2.2",
    "undici": "^8.9.0",
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "firebase": "^12.17.1",
    "happy-dom": "^20.11.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "^57.0.0",
    "vitest": "^4.1.10"
  }
}
