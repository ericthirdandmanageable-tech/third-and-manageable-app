# Appwrite
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=
EXPO_PUBLIC_APPWRITE_PLATFORM=com.thirdandmanageable.app
EXPO_PUBLIC_APPWRITE_DATABASE_ID=

# Temporary Appwrite -> Firebase compatibility bridge. This must be a public,
# credential-free HTTPS origin. Never bundle a Vercel protection-bypass secret
# in an EXPO_PUBLIC variable; use the path-restricted public staging relay.
EXPO_PUBLIC_AUTH_BRIDGE_URL=

# OAuth returns through this public HTTPS callback when a native deep link is
# not accepted by the provider. It is an origin/URL only, never a credential.
EXPO_PUBLIC_OAUTH_BRIDGE_URL=

# HTTPS page on a registered, staging-only Appwrite Web platform. It hands the
# one-hour Appwrite recovery link back to the native reset screen without
# putting a secret in the app configuration.
EXPO_PUBLIC_PASSWORD_RECOVERY_URL=
# Backward-compatible EAS name; either recovery variable may be used.
EXPO_PUBLIC_PASSWORD_RECOVERY_BRIDGE_URL=

# Public support and legal destinations used by the native app.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=

# Firebase staging client configuration. The replacement build authenticates
# with a server-minted custom token before rendering Firestore-backed screens.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Collections
EXPO_PUBLIC_APPWRITE_PROFILES_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_CHECKINS_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_COMPLETIONS_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_ROOMS_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_MESSAGES_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_SUPPORT_REQUESTS_COLLECTION_ID=

# Gemini AI
EXPO_PUBLIC_GEMINI_API_KEY=
